# ==============================================================================
# Retail KPI Intelligence Platform - Production Environment Configuration
# Template File (.env.example) - DO NOT commit real secrets to Git
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Retail KPI Intelligence Platform"
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15+ with PostGIS)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
#
# Option A: Supabase PostgreSQL (Free Tier: 500 MB database, PostGIS built-in)
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Render Managed PostgreSQL (Free Tier: 1 GB, PostGIS supported)
# DATABASE_URL=postgresql://retail_user:[password]@dpg-[unique-id]-a.oregon-postgres.render.com/retail_kpi
#
# Option C: Local / Docker Compose
DATABASE_URL=postgresql://retail_user:retail_secure_password_2026@localhost:5432/retail_kpi

# ------------------------------------------------------------------------------
# 3. REDIS IN-MEMORY CACHE
# ------------------------------------------------------------------------------
# Option A: Upstash Redis (Free Tier: 10,000 commands/day, Serverless TLS)
# REDIS_URL=rediss://default:[password]@[region].upstash.io:6379
#
# Option B: Render Redis / Docker Compose / Local
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate cryptographic 64-char hex keys using: openssl rand -hex 32
SECRET_KEY=generate_and_paste_a_secure_64_character_random_hex_string_here
JWT_SECRET=generate_and_paste_a_secure_64_character_random_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. AI ANALYST (Google Gemini 2.5 Flash API)
# ------------------------------------------------------------------------------
# Obtain free API key at: https://aistudio.google.com/app/apikey
# Free tier offers generous RPM rate limits suited for retail analysis
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of origins authorized to send authenticated API requests.
# Note: In production, backend also matches regex r"^https:\/\/.*\.vercel\.app$"
CORS_ORIGINS=https://retail-kpi.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (Vercel / Vite)
# ------------------------------------------------------------------------------
# URL pointing to the deployed FastAPI backend (Render Web Service)
# Can be provided with or without trailing /api
VITE_API_URL=https://retail-kpi-backend.onrender.com/api
